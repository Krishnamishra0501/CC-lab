%{
#include <stdio.h>

char changeCase(char c)
{
    if (c >= 'a' && c <= 'z')
        return c - 'a' + 'A';   // lowercase → uppercase
    else if (c >= 'A' && c <= 'Z')
        return c - 'A' + 'a';   // uppercase → lowercase

    return c;
}
%}

%%
[a-zA-Z]    { putchar(changeCase(yytext[0])); }
.           { putchar(yytext[0]); }
%%

int main()
{
    yylex();
    return 0;
}
